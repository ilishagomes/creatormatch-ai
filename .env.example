# ─────────────────────────────────────────────────────────────
# CreatorMatch AI — environment variables
#
# 1. Copy this file:      cp .env.example .env
# 2. Fill in the values in .env (NOT in this file).
# 3. Restart `npm run dev` after changing .env.
#
# .env is git-ignored. Never commit a real API key.
# All variables are read ONLY by the backend; none reach the browser.
# ─────────────────────────────────────────────────────────────

# Anthropic API key, needed only for AI outreach emails and AI summaries.
# Create one at https://console.anthropic.com → Settings → API keys.
# It starts with "sk-ant-". Leave it empty to run everything else without AI.
ANTHROPIC_API_KEY=

# Claude model used for outreach emails and summaries.
ANTHROPIC_MODEL=claude-opus-5-5

# Port for the Express API (the web app's dev proxy follows this automatically).
PORT=3001

# SQLite database file, relative to the server/ folder. Created automatically.
DATABASE_PATH=./data/creatormatch.db
